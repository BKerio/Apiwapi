{
  "name": "push-notification-platform-backend",
  "version": "1.0.0",
  "description": "Push Notification Platform - Core API Service",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --watch src/**/*.ts --ext ts --exec npx tsx src/server.ts",
    "build": "prisma generate && tsc && node -e \"require('fs').cpSync('src/generated', 'dist/generated', {recursive:true})\"",
    "start": "node dist/server.js",
    "postinstall": "prisma generate"
  },
  "keywords": [
    "push-notifications",
    "firebase",
    "fcm",
    "express",
    "typescript"
  ],
  "author": "Org",
  "license": "ISC",
  "type": "commonjs",
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "firebase-admin": "^14.4.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "pg": "^8.20.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "prisma": "^7.8.0",
    "socket.io": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.2.0",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "dotenv": "^17.4.2",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
