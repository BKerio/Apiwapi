# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# CORS - comma-separated list of allowed origins (use * for open access in dev)
CORS_ORIGIN=*

# Database (PostgreSQL connection string)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Push gateway (Firebase) credentials are NOT set here - they're pasted as a
# service-account JSON blob into Settings → Push notifications (Firebase) in
# the admin panel once running, encrypted at rest using JWT_SECRET above.
# See modules/settings/push-gateway.service.ts.
